# Use the pooled PostgreSQL connection string from Neon for local development.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# NEON_DATABASE_URL is also accepted. NETLIFY_DATABASE_URL remains supported
# only for Netlify deployment environment variables.
# NEON_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# NETLIFY_DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
NEON_API_URL=https://ep-super-king-b3dwl2jz.apirest.c-4.ap-southeast-1.aws.neon.tech/neondb/rest/v1
NEON_AUTH_URL=https://ep-super-king-b3dwl2jz.neonauth.c-4.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_API_KEY=replace_with_your_neon_data_api_key
PAYMONGO_SECRET_KEY=sk_test_replace_with_your_paymongo_secret_key
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000
FRONTEND_URL=http://localhost:3000
# Netlify deployment value: FRONTEND_URL=https://trypmate.netlify.app
